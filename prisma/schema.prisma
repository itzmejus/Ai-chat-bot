// Mosaed database schema.
//
// Multi-tenancy rule: every tenant-owned model carries `workspaceId`. Application
// code must reach those models through `tenantDb(workspaceId)` (src/server/db/tenant.ts),
// which forces the workspace filter onto every query.
//
// The connection URL lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  agent
}

enum Industry {
  clinic
  real_estate
  salon
  restaurant
  car_rental
  retail
  other
}

enum Language {
  en
  ar
  both
}

enum Tone {
  formal
  friendly
}

enum WidgetPosition {
  left
  right
}

enum SourceType {
  url
  file
  faq
  notes
}

enum SourceStatus {
  processing
  ready
  failed
}

// Designed for future channels: WhatsApp and Instagram land in the same inbox.
enum Channel {
  web
  whatsapp
  instagram
}

enum ConversationStatus {
  ai // AI is answering
  needs_human // AI flagged it, or the customer asked for a person
  human // an agent has taken over; AI is paused
  closed
}

enum MessageRole {
  customer
  assistant
  agent
  system
}

enum LeadStatus {
  new
  contacted
  converted
}

// ---------------------------------------------------------------- global tables

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String? // null for Google-only accounts
  createdAt    DateTime @default(now())

  memberships Membership[]
  messages    Message[]
}

model Plan {
  id                String @id // "free" | "starter" | "pro"
  name              String
  monthlyMessages   Int
  maxKnowledgePages Int
  maxAgents         Int

  workspaces Workspace[]
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  industry        Industry
  websiteUrl      String?
  defaultLanguage Language @default(both)
  workingHours    Json // { mon: { open: "09:00", close: "18:00", closed: false }, ... }
  phone           String?
  whatsapp        String?
  publicKey       String   @unique // goes in the widget embed code; safe to expose
  planId          String   @default("free")
  createdAt       DateTime @default(now())

  plan                 Plan                  @relation(fields: [planId], references: [id])
  memberships          Membership[]
  invites              Invite[]
  assistantSettings    AssistantSettings?
  widgetSettings       WidgetSettings?
  notificationSettings NotificationSettings?
  sources              KnowledgeSource[]
  chunks               Chunk[]
  conversations        Conversation[]
  messages             Message[]
  leads                Lead[]
  usage                UsageCounter[]
}

// --------------------------------------------------------- tenant-owned tables

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(agent)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AssistantSettings {
  id                String @id @default(cuid())
  workspaceId       String @unique
  assistantName     String @default("Assistant")
  greeting          String @default("Hi! How can I help you today?")
  tone              Tone   @default(friendly)
  extraInstructions String @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WidgetSettings {
  id             String         @id @default(cuid())
  workspaceId    String         @unique
  brandColor     String         @default("#2563eb")
  logoUrl        String?
  position       WidgetPosition @default(right)
  preChatForm    Boolean        @default(false)
  allowedDomains String[]       @default([])

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  notifyOnLead       Boolean  @default(true)
  notifyOnNeedsHuman Boolean  @default(true)
  emails             String[] @default([])

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model KnowledgeSource {
  id           String       @id @default(cuid())
  workspaceId  String
  type         SourceType
  title        String // URL, file name, FAQ question, or "Business notes"
  content      String? // FAQ answer, notes text, or text extracted from a file
  url          String?
  status       SourceStatus @default(processing)
  error        String?
  pageCount    Int          @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    Chunk[]

  @@index([workspaceId, createdAt])
}

model Chunk {
  id          String                      @id @default(cuid())
  workspaceId String
  sourceId    String
  content     String
  tokenCount  Int
  url         String? // page the chunk came from, for crawled sites
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                    @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
}

model Conversation {
  id              String             @id @default(cuid())
  workspaceId     String
  channel         Channel            @default(web)
  visitorId       String // anonymous ID from the widget (or phone/handle on other channels)
  visitorName     String?
  visitorPhone    String?
  status          ConversationStatus @default(ai)
  assignedAgentId String?
  unread          Boolean            @default(true)
  isTest          Boolean            @default(false) // "Test your assistant" chats; excluded from stats
  lastMessageAt   DateTime           @default(now())
  createdAt       DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]
  leads     Lead[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, visitorId])
}

model Message {
  id             String      @id @default(cuid())
  workspaceId    String
  conversationId String
  role           MessageRole
  content        String
  authorId       String? // agent messages only: the team member who wrote it
  confidence     Float? // assistant messages only
  answered       Boolean? // assistant messages only: false = knowledge base had no answer
  createdAt      DateTime    @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

model Lead {
  id             String     @id @default(cuid())
  workspaceId    String
  conversationId String?
  name           String?
  phone          String?
  email          String?
  status         LeadStatus @default(new)
  createdAt      DateTime   @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model UsageCounter {
  id          String @id @default(cuid())
  workspaceId String
  month       String // "YYYY-MM" in UTC
  aiMessages  Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month])
}

// ------------------------------------------------------------------ infra

// Fixed-window counters for the public chat endpoint.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}
