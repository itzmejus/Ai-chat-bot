# Copy to .env and fill in. Never commit .env.

# --- App ---------------------------------------------------------------------
APP_NAME="Selo Assist"
APP_URL="http://localhost:3000"
# Hostname the customer-facing widget is served from. Leave empty locally (uses APP_URL).
# Production example: APP_URL="https://www.assist.siteselo.com", WIDGET_URL="https://chat.siteselo.com"
# Both hostnames point at the same deployment.
WIDGET_URL=""
# Hostname of the public marketing site. Leave empty (the usual setup) to serve it on the app's
# hostname: the site at /, the dashboard at /dashboard. Set it only to give the site its own domain.
SITE_URL=""
# Hostnames the app used to live on, comma separated. Everything opened on them is redirected to
# the same path on the current address. Example: "app.siteselo.com,www.app.siteselo.com"
REDIRECT_HOSTS=""
# Shown in the site footer and on the legal pages when set.
CONTACT_EMAIL=""
# Ownership codes from Google Search Console and Bing Webmaster Tools (the "HTML tag" method:
# paste only the content value). They add the verification tags to every page.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# --- Database ----------------------------------------------------------------
# Supabase (dashboard > Connect):
#   DATABASE_URL = transaction pooler (port 6543), used by the running app
#   DIRECT_URL   = session pooler (port 5432), used for migrations and realtime
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Product photos (Supabase Storage) ---------------------------------------
# Supabase dashboard > Project Settings > API. The service_role key is a secret: it can read and
# write all of the project's storage, so it stays on the server. Leave both empty to run without
# photo upload (products can still be added, without pictures).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Websites built with JavaScript -------------------------------------------
# Many modern sites send an almost empty page and draw it in the browser, so a plain download
# finds no text. Set JS_RENDER_URL to read such pages through a page-reader service that runs
# a real browser. "https://r.jina.ai/" (Jina Reader) works without an account at a low rate
# limit; add its API key for more. Only the public page address is sent. Empty turns it off.
JS_RENDER_URL=""
JS_RENDER_API_KEY=""

# --- Background worker ------------------------------------------------------
# Leave empty to run the ingestion worker inside the web server (simplest).
# Set to "external" if you run `npm run worker` as a separate service.
WORKER_MODE=""

# --- Plans -------------------------------------------------------------------
# Online payment is not built yet. Set to "true" to let workspace owners switch plan freely
# from Settings (development and demos). Leave empty in production.
ALLOW_FREE_PLAN_CHANGE=""

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- Auth (Auth.js / NextAuth) -----------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Optional. Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (invites and notifications) ---------------------------------------
# Leave EMAIL_SERVER_HOST empty in development: emails are logged to the console.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Selo Assist <no-reply@example.com>"

# WhatsApp alerts to a business's team when a customer needs a person (optional).
# Uses Meta's WhatsApp Business Cloud API. Leave empty to turn the alerts off: they are
# written to the server log instead. Setup steps are in docs/DEPLOYMENT.md.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Name of the approved message template (default "needs_human_alert"), and the Graph API version.
WHATSAPP_TEMPLATE_NEEDS_HUMAN=""
WHATSAPP_API_VERSION=""

# --- Demo data (npm run db:seed) ---------------------------------------------
# Password for the demo account. Leave empty to have a random one generated and printed.
SEED_PASSWORD=""
